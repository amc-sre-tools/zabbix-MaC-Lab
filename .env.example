# =============================================================================
# Environment Variables Template
# =============================================================================
# Author: Andrés M. Correa
# Email: korc.dev@gmail.com
# Description: Template for environment variables. COPY THIS FILE TO .env
#             AND FILL WITH SECURE VALUES. DO NOT COMMIT .env TO GIT!
# =============================================================================

# OpenBao Configuration
BAO_ADDR=http://openbao:8200
BAO_TOKEN=CHANGE_ME_GET_FROM_OPENBAO
BAO_DEV_ROOT_TOKEN_ID=root-token-dev-only

# PostgreSQL Configuration (POD2)
# Get from OpenBao: secret/data/postgresql/admin
# Note: PostgreSQL has 3 separate databases for Zabbix versions:
#   - zabbix60 (Zabbix 6.0 LTS)
#   - zabbix70 (Zabbix 7.0)
#   - zabbix74 (Zabbix 7.4 LTS)
POSTGRES_USER=zabbix
POSTGRES_PASSWORD=CHANGE_ME_GET_FROM_OPENBAO

# SonarQube Configuration (POD1)
# Get from OpenBao
SONARQUBE_DB_USER=sonarqube
SONARQUBE_DB_PASSWORD=CHANGE_ME_GET_FROM_OPENBAO

# FastAPI Configuration (POD3)
# Get from OpenBao: secret/data/fastapi/app
FASTAPI_SECRET_KEY=CHANGE_ME_GET_FROM_OPENBAO
FASTAPI_API_KEY=CHANGE_ME_GET_FROM_OPENBAO

# Zabbix API Keys (POD2)
# Get from OpenBao: secret/data/zabbix/api-keys
ZABBIX_API_TOKEN=CHANGE_ME_GET_FROM_OPENBAO